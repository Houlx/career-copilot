# Default mode never contacts a model provider. Copy to .env at the repository root.
AI_MODE=fake
APP_ENV=development
AI_DEBUG_PAYLOADS=0
DATABASE_PATH=data/career-copilot.sqlite3
REPLAY_DIR=backend/fixtures/replay
# Shared fallback configuration; role-specific settings below override it.
API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL=
JUDGE_PROVIDER=jev
# Role-specific HTTP timeouts in seconds: > 0 and <= 300; defaults preserve 30s.
JUDGE_TIMEOUT_SECONDS=30
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
GENERATION_PROVIDER=openai_compatible
# json_schema (default) or json_object for GLM; local strict validation applies to both.
GENERATION_STRUCTURED_OUTPUT=json_schema
GENERATION_TIMEOUT_SECONDS=30
GENERATION_MODEL=
GENERATION_BASE_URL=
GENERATION_API_KEY=
